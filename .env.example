# Copie para .env e preencha. NUNCA commite o .env (está no .gitignore).

# ----- Banco (docker-compose) -----
POSTGRES_DB=lista_presentes
POSTGRES_USER=lista
POSTGRES_PASSWORD=lista

# ----- Datasource da aplicação -----
# Local (rodando a app na máquina, banco no compose):
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lista_presentes
SPRING_DATASOURCE_USERNAME=lista
SPRING_DATASOURCE_PASSWORD=lista
# Em prod (Railway): mapeie a partir de DATABASE_URL para o formato jdbc:postgresql://host:port/db

# ----- Segurança / PII (gere chaves fortes; ex.: openssl rand -base64 32) -----
PII_ENCRYPTION_KEY=        # cripto de nome/telefone do convidado
PHONE_HMAC_KEY=            # HMAC para phone_hash (lookup e rastreamento)
JWT_SECRET=               # segredo de assinatura de tokens de sessão

# ----- Integrações / rede -----
CORS_ALLOWED_ORIGINS=http://localhost:3000
MP_WEBHOOK_BASE_URL=      # URL pública para o webhook do Mercado Pago (em prod)
